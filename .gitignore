__pycache__/
*.pyc
.DS_Store
# Sandbox di prova generate dai test end-to-end
/sandbox/
# Generato da build.py, mai committato: vedi atlascli/version.py
/atlascli/_payload.py
# Coda locale degli attriti da sistemare, si svuota man mano che li chiudiamo
/atlas-friction.md
# Stato del pairing Telegram (D05), scritto a runtime dal relay: mai dati d'esempio da versionare
/relay/state/

# Worktree dei subagent isolati (isolation: worktree): li crea l'harness,
# non vanno versionati. release.py rifiuta un git status sporco per questa
# cartella se resta solo in .git/info/exclude: va tracciata qui.
.claude/worktrees/

# Atlas: artefatti rigenerabili
.atlas/graphs/*/dashboard.html
.atlas/graphs/*/graph.json.lock
.atlas/graphs/*/.graph.json.tmp
.atlas/graphs/*/retry-state.json
.atlas/graphs/*/run-state.json
.atlas/current
.atlas/whoami

# handoff di sessione, locale
HANDOFF.md
